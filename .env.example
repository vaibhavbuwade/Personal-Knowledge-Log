# ==============================================================================
# Django Configuration
# ==============================================================================
# Secret Key: Random string for production cryptographic signing
SECRET_KEY=django-insecure-learning-logs-dev-key-change-in-production-12345

# Debug Mode: True for local development, False for production
DEBUG=True

# Allowed Hosts: Comma-separated domain names or IP addresses
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional Production Database URL (PostgreSQL)
# Format: postgresql://user:password@hostname:5432/database_name
# If left empty, SQLite (db.sqlite3) will be used automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_db

# ==============================================================================
# AI Provider Configuration (Default: 'mock' - Zero Cost, No API Key Required)
# ==============================================================================
# Provider options:
# - 'mock': High-quality local rule/heuristic engine. No API key needed.
# - 'openai': Standard OpenAI models (e.g., gpt-4o-mini). Requires AI_API_KEY.
# - 'groq': Ultra-fast open models (e.g., llama-3.3-70b-versatile). Free tier available.
# - 'ollama': Local offline inference (e.g., llama3.2). Requires no external API.
# - 'gemini': Google Gemini REST OpenAI-compatible endpoint.
AI_PROVIDER=mock

# AI API Key (Leave empty when using AI_PROVIDER=mock or local Ollama)
AI_API_KEY=

# AI Model Name (Optional override; defaults per provider)
# Examples: gpt-4o-mini, llama-3.3-70b-versatile, llama3.2
AI_MODEL=

# AI API Base URL (Optional custom endpoint)
# Default for OpenAI: https://api.openai.com/v1
# Default for Groq: https://api.groq.com/openai/v1
# Default for Ollama: http://localhost:11434/v1
AI_BASE_URL=

# AI Request Timeout (in seconds)
AI_TIMEOUT=15

# ==============================================================================
# Email Configuration (Default: Console Backend for Local Dev - No SMTP Required)
# ==============================================================================
# For local testing, EMAIL_BACKEND defaults to django console backend.
# OTP codes and password reset links are clearly displayed in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional: Production SMTP Email Settings (e.g., Gmail, SendGrid, Mailgun)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_specific_password
# DEFAULT_FROM_EMAIL="AI Notes & Document Assistant <noreply@yourdomain.com>"

