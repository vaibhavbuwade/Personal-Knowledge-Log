# Django Secret Key (Generate a random string for production)
SECRET_KEY=django-insecure-replace-this-with-a-secure-secret-key-in-production

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts: Comma-separated domain names or IP addresses
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database URL: Optional PostgreSQL connection string for production
# Format: postgres://username:password@hostname:5432/database_name
# If left empty, SQLite (db.sqlite3) will be used automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_db
